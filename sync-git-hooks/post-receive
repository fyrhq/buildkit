#!/bin/sh
set -eu

log() { printf '[remote] %s\n' "$*" >&2; }
is_deleted() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }

# pre-receive already reports a missing origin.
if ! git remote get-url origin >/dev/null 2>&1; then
    exit 0
fi

# Batch the successfully received branch and tag updates into one push.
set --
while read -r old_commit new_commit ref; do
    is_deleted "$new_commit" && continue
    case "$ref" in
        refs/heads/*|refs/tags/*) set -- "$@" "$new_commit:$ref" ;;
    esac
done

[ "$#" -gt 0 ] || exit 0
log 'push to remote/origin'
if ! git -c push.followTags=false push --no-follow-tags --recurse-submodules=no origin "$@"; then
    log 'push to remote/origin failed; received refs remain in this repository'
    exit 1
fi
